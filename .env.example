# Copy this file to .env and fill in your keys.
# The app runs WITHOUT keys (rule-based fallback), but the critic/synthesis
# agents produce much stronger reasoning with a real LLM.

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NASA ADS - free API token for paper search
# Register at: https://ui.adsabs.harvard.edu/user/settings/token
NASA_ADS_TOKEN=
